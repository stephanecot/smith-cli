[project]
name = "{{package_name}}"
version = "0.1.0"
description = "{{description}}"
readme = "README.md"
requires-python = ">={{python_version}}"
dependencies = [
  "fastapi>=0.115,<1.0",
  "uvicorn[standard]>=0.30,<1.0",
  "pydantic>=2.7,<3.0",
  "pydantic-settings>=2.3,<3.0",
  # @stack-gated:has_db
  "sqlalchemy[asyncio]>=2.0,<3.0",
  "alembic>=1.13,<2.0",
  # @stack-gated:has_db,db_driver=postgresql+asyncpg
  "asyncpg>=0.29,<1.0",
  # @stack-gated:has_db,db_driver=sqlite+aiosqlite
  "aiosqlite>=0.20,<1.0",
  # @stack-gated:has_jwt
  "python-jose[cryptography]>=3.3,<4.0",
  "passlib[bcrypt]>=1.7,<2.0",
  "python-multipart>=0.0.9,<1.0",
]

[project.optional-dependencies]
dev = [
  "pytest>=8",
  "pytest-asyncio>=0.23",
  "pytest-cov>=5",
  "httpx>=0.27",
  "ruff>=0.5",
  "mypy>=1.10",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{package_name}}"]

[tool.ruff]
line-length = 100
target-version = "py312"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "C4", "RUF", "N"]
ignore = ["E501"]

[tool.ruff.lint.isort]
known-first-party = ["{{package_name}}"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths    = ["tests"]
addopts      = ["--strict-markers", "--strict-config"]

[tool.coverage.run]
branch = true
source = ["src/{{package_name}}"]

[tool.mypy]
python_version = "3.12"
strict = true
warn_unused_configs = true

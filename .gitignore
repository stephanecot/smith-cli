# Smith — root .gitignore
# Per-tool .gitignore files inside subprojects (frontend/.gitignore, src/app/api/.gitignore)
# stay in place and are layered on top of this file.

# Per-machine agent / skill usage history (smi-agent-stats skill)
/AGENT_STATS.MD
/samples/

# Smith CLI showcase sample — fully regenerated by /smith-new-project ;
# do not commit its install state (configs, scripts, hooks, scaffolded
# source). The bin/ skills + bundles + templates that populate it are
# the source of truth.
/cli/samples/angular-sample/

# ───────────────────────────── OS / Editor noise ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IntelliJ / JetBrains
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code (keep .vscode/extensions.json shared via per-project allowlists if needed)
.vscode/*
!.vscode/extensions.json

# Eclipse / NetBeans
.settings/
.project
.classpath
.factorypath
nbproject/private/

# ─────────────────────────────────── Java ────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ──────────────────────────────── Node / Angular ─────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp/
.pnp.js
.angular/cache/
dist/
coverage/
.nyc_output/

# Vitest / Karma
.vitest-cache/

# ──────────────────────────────── Environments ───────────────────────────────
.env
.env.*
!.env.example
!**/.env.example

# Local Docker overrides
deploy/local/.env
deploy/local/docker-compose.override.yml

# ─────────────────────────────── Build artefacts ─────────────────────────────
# Liquibase rollback dumps
backend/**/liquibase.dump.json

# Generated OpenAPI client housekeeping (the actual code under src/app/api/ IS committed)
frontend/src/app/api/.openapi-generator/

# ─────────────────────────────────── Logs ────────────────────────────────────
*.log
logs/

.logs/

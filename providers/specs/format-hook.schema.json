{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smith-providers/specs/format-hook.schema.json",
  "title": "Smith provider — format-hook.yaml",
  "description": "Per-kind YAML describing the hook artefact for a provider. Catalogs the events that fire, the handler types that can be plugged in, and any shared fields applicable to every handler. For providers without in-process events (e.g. Copilot), events enumerates host-driven triggers (VS Code task, git hook, CI workflow) and handler_types describes their config schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "provider",
    "title",
    "consumer_path",
    "example",
    "events",
    "handler_types",
    "conventions"
  ],
  "properties": {
    "kind":          { "const": "hook" },
    "provider":      { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title":         { "type": "string" },
    "consumer_path": { "type": "string" },
    "example": {
      "type": "string",
      "pattern": "^example/example-hook[^/]*\\.[^/]+$",
      "description": "Relative path to the companion example file under example/. Filename MUST start with example-hook and may carry a provider-specific suffix before the extension (e.g. example-hook-tasks.json)."
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "fires", "can_block"],
        "properties": {
          "name":       { "type": "string" },
          "fires":      { "type": "string" },
          "can_block":  { "type": "boolean" },
          "matcher":    { "description": "Matcher syntax — string description, array of literal values, or null." },
          "default_timeout_seconds": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "handler_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "fields"],
        "properties": {
          "type":   { "type": "string" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "notes":  { "type": "string" }
        }
      }
    },
    "shared_handler_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "meaning"],
        "properties": {
          "field":   { "type": "string" },
          "meaning": { "type": "string" }
        }
      }
    },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
